// 发布记录（docs/prd/08-publish.md「数据与接口」、GLOSSARY「发布记录」、docs/prd/12 MUST 6）。
//
// 一条记录只表达「用户手动确认这一版文案已经发布过了」，不代表系统对接了小红书：
// 平台、发布日期、标题快照与采用的素材都由用户在这次操作里给出，系统不推断发布成功。
//
// `copyVersionId` 唯一：同一文案版本重复标记只更新这一行（AC-LIB-8），不会产生第二条。
// `titleSnapshot` 保留当时的标题，之后编辑版本也能看出发布时用的标题；
// `selectedAssetIds` 是版本当时选中的素材快照，素材被删后仍能看出发布了什么。
// `collectionId` 是冗余列：资源夹内列表与按资源夹筛选都靠它，且删除资源夹时与版本一起级联
// （docs/prd/01 MUST 5、docs/prd/00-overview.md 全局规则 7）。
model PublishRecord {
  id               String          @id @default(uuid())
  copyVersionId    String          @unique @map("copy_version_id")
  collectionId     String          @map("collection_id")
  platform         String
  publishedAt      DateTime        @map("published_at")
  titleSnapshot    String          @map("title_snapshot")
  selectedAssetIds String[]        @default([]) @map("selected_asset_ids")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  copyVersion      CopyVersion     @relation(fields: [copyVersionId], references: [id], onDelete: Cascade)
  collection       MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // 发布记录按发布时间倒序列出，并按资源夹筛选（docs/prd/08 SHOULD）。
  @@index([collectionId, publishedAt])
  @@map("publish_record")
}
