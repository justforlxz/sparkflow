// 创作任务、执行阶段、创作结果与生成图片（docs/prd/04-generation-task.md、docs/prd/00-overview.md 第 5 节）。
//
// 任务状态不落库：由两条阶段的状态派生（见 `src/modules/generation/derive.ts`）。
// `generation_result.task_id` 是唯一约束，用它表达「一个任务最多一个结果」；任务侧不再重复存
// `result_id`，避免两个指针互相漂移（任务详情里把 result_id 派生出来）。
//
// `collectionId` 用外键指向 `media_collection` 并声明 `onDelete: Cascade`：删除资源夹时
// 任务、阶段、结果与生成图片随数据库一并删除（docs/prd/00-overview.md 全局规则 7）。
// `tags` 是 text[]，空数组表示文案阶段尚未成功（docs/prd/06-generation-copy.md）。
model GenerationTask {
  id            String            @id @default(uuid())
  collectionId  String            @map("collection_id")
  visualStyle   String            @map("visual_style")
  copyStyle     String            @map("copy_style")
  imageCount    Int               @map("image_count")
  extraPrompt   String?           @map("extra_prompt")
  // 创建任务时固化的两份 Agent 配置快照（docs/prd/03-agent-config.md MUST 6）。
  // 密钥不进快照：执行时按快照里的 gatewayId 现取（docs/prd/04 MUST 4）。
  agentSnapshot Json              @map("agent_snapshot")
  createdAt     DateTime          @default(now()) @map("created_at")
  collection    MediaCollection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stages        GenerationStage[]
  result        GenerationResult?

  @@index([collectionId, createdAt])
  @@map("generation_task")
}

// 一个任务固定两条阶段：`stage` 取 `image` / `copy`；`status` 取 `queued` / `running` /
// `succeeded` / `failed`。`attempts` 是已排入执行队列的尝试次数：创建时为 1，每次重试加 1。
// `error` 存 `{ code, message, at }`；`meta` 存各阶段的调用摘要（模型名、耗时、每批张数等）。
model GenerationStage {
  id         String         @id @default(uuid())
  taskId     String         @map("task_id")
  stage      String
  status     String         @default("queued")
  attempts   Int            @default(0)
  error      Json?
  meta       Json?
  startedAt  DateTime?      @map("started_at")
  finishedAt DateTime?      @map("finished_at")
  task       GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stage])
  @@index([status])
  @@map("generation_stage")
}

// 生图阶段成功后创建，文案阶段成功后补齐 title / body / tags（docs/prd/04「产出写入时机」）。
// title / body 用可空列表示「文案还没成功」，与空字符串区分开。
model GenerationResult {
  id           String           @id @default(uuid())
  taskId       String           @unique @map("task_id")
  collectionId String           @map("collection_id")
  title        String?
  body         String?
  tags         String[]         @default([])
  visualStyle  String           @map("visual_style")
  createdAt    DateTime         @default(now()) @map("created_at")
  collection   MediaCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  task         GenerationTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assets       GeneratedAsset[]

  @@index([collectionId, createdAt])
  @@map("generation_result")
}

// 生成图片：落在 `<UPLOAD_DIR>/generated-assets/<resultId>/` 下，数据库只存 storage_key。
// 宽高由生图阶段回填（mock 实现不知道尺寸时留空）。
model GeneratedAsset {
  id         String           @id @default(uuid())
  resultId   String           @map("result_id")
  storageKey String           @map("storage_key")
  fileName   String           @map("file_name")
  mimeType   String           @map("mime_type")
  sortOrder  Int              @default(0) @map("sort_order")
  width      Int?
  height     Int?
  result     GenerationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId, sortOrder])
  @@map("generated_asset")
}
