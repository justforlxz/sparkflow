// 媒体资源夹与原始图片（docs/prd/01-media-collection.md、docs/prd/00-overview.md 第 5 节）。
//
// 提取运行、素材库、文案版本、发布记录分属各自的 schema 文件。那些模块在自己的 schema 里用
// `collectionId` 外键并声明 `onDelete: Cascade`，这样删除资源夹时数据库会一并删掉它们
// （docs/prd/00-overview.md 全局规则 7、docs/prd/12 MUST 8）。本文件只保留这些外键的反向字段，
// 关系本身（字段、`onDelete`）在各自模块的 schema 里声明，这里不写它们的列。
//
// 没有 `extract_target`：类别（material / border / other）取代了单值提取目标（ADR 0010、MKACG-938）。
model MediaCollection {
  id          String   @id @default(uuid())
  name        String
  platform    String?
  sourceUrl   String?  @map("source_url")
  sourceTitle String?  @map("source_title")
  sourceBody  String?  @map("source_body")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // 文案版本号的计数器：只增不减，删除版本后也不回收（docs/prd/12 MUST 5：version_no 不复用）。
  // 单独一列而不是「当前最大版本号 + 1」，是因为删掉最高版本后那种算法会复用编号。
  copyVersionSeq Int    @default(0) @map("copy_version_seq")
  assets      MediaAsset[]
  // 以下三组反向关系由各自的 schema 文件声明，删除资源夹时级联。
  extractionRuns ExtractionRun[]
  libraryAssets  LibraryAsset[]
  copyVersions   CopyVersion[]
  // 发布记录的反向关系由发布模块（prisma/schema/publish.prisma）声明。
  publishRecords PublishRecord[]

  @@map("media_collection")
}

// 原图。`storageKey` 与记录解耦：解除关联只删这一行，磁盘文件保留（MUST 4）。
//
// 从原图派生的素材（library_asset）不在此声明反向关系：素材只记 `source_asset_id` 字符串，
// 原图被解除关联后素材要留在库里（docs/prd/12 MUST 4）。
model MediaAsset {
  id           String          @id @default(uuid())
  collectionId String          @map("collection_id")
  storageKey   String          @map("storage_key")
  fileName     String          @map("file_name")
  mimeType     String          @map("mime_type")
  size         Int
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  collection   MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, sortOrder])
  @@map("media_asset")
}
