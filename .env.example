# 复制为 .env 后按需修改；docker compose 会读取它。
# 生产部署至少要改 POSTGRES_PASSWORD 与 AUTH_SECRET。

POSTGRES_USER=sparkflow
POSTGRES_PASSWORD=
POSTGRES_DB=sparkflow
APP_PORT=3000

# 会话与密钥派生的根密钥，至少 32 个字符：openssl rand -base64 48
AUTH_SECRET=

# 本地直连数据库时使用（devcontainer 内由 post-create.sh 追加成 db 服务地址）
DATABASE_URL=postgresql://sparkflow:change-me@localhost:5432/sparkflow

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
GENERATION_ADAPTER=real

# 只有前面挂了可信反向代理时才设为 true（此时按 x-forwarded-for 首段做登录限速；
# 直连部署保持 false，按单一来源限速，避免伪造请求头绕过）
TRUST_PROXY=false
