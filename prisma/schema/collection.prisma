// 媒体资源夹、总资源库（照片池）与资源夹关联（docs/prd/01-media-collection.md、
// docs/adr/0012-总资源库与资源夹的相册模型.md 第 1 条、docs/prd/00-overview.md 第 5 节）。
//
// 提取运行与素材库分属 `extraction.prisma`。那个模块在自己的 schema 里用 `collectionId` 外键并声明
// `onDelete: Cascade`，这样删除资源夹时数据库会一并删掉它们（docs/prd/00-overview.md 全局规则 7、
// docs/prd/12 MUST 8）。本文件只保留这些外键的反向字段，关系本身（字段、`onDelete`）在各自的
// schema 里声明，这里不写它们的列。
//
// 文案版本与发布记录已下线（ADR 0012 第 3 条、MKACG-976）：那两张表与资源夹上的版本号计数器列
// 在新迁移里删除，所以本文件不再声明它们的反向关系。
//
// 没有 `extract_target`：类别（material / border / other）取代了单值提取目标（ADR 0010、MKACG-938）。
//
// 本文件里的 `MediaAsset.collectionId` 与 `MediaAsset.sortOrder` 是**兼容列**：它们只为了让上一版
// 镜像在回滚后还能读到数据而存在，新代码不再写也不再读。删除它们的时间点在 MKACG-981
// （AGENTS.md 硬性规则 3「删列/改名拆两个版本」、docs/development.md「迁移必须向前兼容」）。
model MediaCollection {
  id          String   @id @default(uuid())
  name        String
  platform    String?
  sourceUrl   String?  @map("source_url")
  sourceTitle String?  @map("source_title")
  sourceBody  String?  @map("source_body")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // 兼容反向关系：上一版镜像靠它读「这个夹有哪些照片」。新代码一律走 `collectionAssets`，
  // 不查这个字段（留着只是因为删列要等 MKACG-981）。
  assets           MediaAsset[]
  collectionAssets CollectionAsset[]
  // 以下两组反向关系由 extraction.prisma 声明，删除资源夹时级联。
  extractionRuns ExtractionRun[]
  libraryAssets  LibraryAsset[]

  @@map("media_collection")
}

// 总资源库（照片池）里的一张原图（ADR 0012 第 1 条）。
//
// 照片**不属于**任何资源夹：归属关系在 `collection_asset` 里，一张照片可以同时属于多个资源夹
// （相册语义）。`storageKey` 与记录解耦：从夹里移除只删关联行，磁盘文件保留（PRD 01 MUST 4）；
// 只有从总资源库显式删除才删文件。
//
// `collectionId` 与 `sortOrder` 是兼容列（见文件顶部说明）：
// - `collectionId` 可空，新代码写入时为 NULL；迁移来的历史行保留旧值，删除资源夹时被置为 NULL
//   （`onDelete: SetNull`，AC-POOL-8）。**不能**用 `Cascade`：那会在删夹时把迁移来的照片整批删掉。
// - `sortOrder` 只有上一版镜像会读，新代码的排序在 `CollectionAsset.sortOrder` 上。
//
// 从原图派生的素材（library_asset）不在此声明反向关系：素材只记 `source_asset_id` 字符串，
// 原图被解除关联后素材要留在库里（docs/prd/12 MUST 4）。
model MediaAsset {
  id           String            @id @default(uuid())
  collectionId String?           @map("collection_id")
  sortOrder    Int               @default(0) @map("sort_order")
  storageKey   String            @map("storage_key")
  fileName     String            @map("file_name")
  mimeType     String            @map("mime_type")
  size         Int
  createdAt    DateTime          @default(now()) @map("created_at")
  collection   MediaCollection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  collections  CollectionAsset[]

  @@index([collectionId, sortOrder])
  @@map("media_asset")
}

// 资源夹 ↔ 照片 多对多（ADR 0012 第 1 条）。
//
// 删除资源夹只级联删这里的关联行，照片行留在池里；删除照片同样级联删关联行。
// `sortOrder` 是「这张照片在这个夹里的顺序」，所以放在关联行上而不是照片上。
model CollectionAsset {
  collectionId String          @map("collection_id")
  assetId      String          @map("asset_id")
  sortOrder    Int             @default(0) @map("sort_order")
  addedAt      DateTime        @default(now()) @map("added_at")
  collection   MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  asset        MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([collectionId, assetId])
  @@index([collectionId, sortOrder])
  @@map("collection_asset")
}
